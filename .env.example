# Required
BACKEND_SECRET=            # shared with the app (x-backend-secret); the server won't start without it
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
ALLOWED_ORIGINS=           # comma-separated WebSocket origins; empty allows any
MAX_ACTIVE_INTERVIEWS=10
OTEL_EXPORTER_ENDPOINT=    # OTLP/HTTP traces URL; empty creates spans but exports none
OTEL_EXPORTER_API_KEY=     # sent as x-honeycomb-team

# Screening interviews
APP_CALLBACK_URL=          # the app's base URL; transcripts go to {APP_CALLBACK_URL}/api/internal/interview-transcript
VOICE_CALLBACK_SECRET=     # sent as x-voice-callback-secret; the app's VOICE_CALLBACK_SECRET
SCREENING_RESERVED_SLOTS=  # slots only screening may use; default 30% of MAX_ACTIVE_INTERVIEWS
MAX_SESSION_CREATES_PER_MIN=60
